rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Character reference images are strictly private to authenticated users
    match /projects/{projectId}/characters/{characterId}/{imageId} {
      allow read, write: if isAuthenticated();
    }
    
    // Public assets (e.g. project covers if explicitly published)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
