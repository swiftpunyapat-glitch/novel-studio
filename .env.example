# Firebase Client SDK Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# Firebase Admin SDK Configuration (Server-side ONLY - never expose to browser)
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# External AI Read-Only API (Server-side ONLY)
#
# Both variables are REQUIRED. There is no fallback: if either is missing or the
# token is shorter than 16 characters, /api/ai/* refuses every request with 503.
# Generate with:  openssl rand -hex 32
NOVEL_AI_READ_TOKEN=""
# The single Firebase uid whose manuscripts this token may read.
NOVEL_OWNER_UID=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
